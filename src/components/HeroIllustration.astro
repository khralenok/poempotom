<style>
  div {
    width: 100%;
    height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid red;
  }
  svg {
    transform: scale(2);
  }
</style>

<script>
  import { gsap } from "gsap";

  const area = document.querySelector<HTMLDivElement>("#interactive-area");
  const svg = document.querySelector<SVGSVGElement>("#head");
  const eyeRight = document.querySelector<SVGSVGElement>("#eye-right");
  const eyeLeft = document.querySelector<SVGSVGElement>("#eye-left");
  const eyeRightFill = document.querySelector<SVGSVGElement>("#eye-right-fill");
  const eyeRightLine = document.querySelector<SVGSVGElement>("#eye-right-line");
  const eyeLeftFill = document.querySelector<SVGSVGElement>("#eye-left-fill");
  const eyeLeftLine = document.querySelector<SVGSVGElement>("#eye-left-line");
  const hairDynamicFront = document.querySelector<SVGSVGElement>(
    "#hair-dynamic-front",
  );
  const hairDynamicBack1 = document.querySelector<SVGSVGElement>(
    "#hair-dynamic-back-1",
  );
  const hairDynamicBack2 = document.querySelector<SVGSVGElement>(
    "#hair-dynamic-back-2",
  );
  const hairDynamicBack3 = document.querySelector<SVGSVGElement>(
    "#hair-dynamic-back-3",
  );
  const hairDynamicBack4 = document.querySelector<SVGSVGElement>(
    "#hair-dynamic-back-4",
  );

  if (
    hairDynamicFront &&
    hairDynamicBack1 &&
    hairDynamicBack2 &&
    hairDynamicBack3 &&
    hairDynamicBack4
  ) {
    gsap.set([hairDynamicFront, hairDynamicBack1, hairDynamicBack2], {
      transformOrigin: "90% 10%",
    });
    gsap.set([hairDynamicBack3, hairDynamicBack4], {
      transformOrigin: "32% 20%",
    });

    const hairMove = (hairObject: SVGSVGElement) => {
      return gsap
        .timeline()
        .to(hairObject, {
          rotation: 5,
          scaleY: 1.03,
          duration: 1,
          ease: "power1.inOut",
        })
        .to(hairObject, {
          rotation: 0,
          scaleY: 1,
          duration: 0.5,
          ease: "power1.inOut",
        });
    };

    function scheduleHairMove(hairObjects: SVGSVGElement[]) {
      const tl = gsap.timeline({
        delay: gsap.utils.random(2, 6),
        onComplete: () => scheduleHairMove(hairObjects),
      });

      hairObjects.forEach((hairObject, index) => {
        tl.add(hairMove(hairObject), index * 0.3);
      });
    }

    scheduleHairMove([
      hairDynamicFront,
      hairDynamicBack1,
      hairDynamicBack2,
      hairDynamicBack3,
      hairDynamicBack4,
    ]);
  }

  if (eyeRightFill && eyeRightLine && eyeLeftFill && eyeLeftLine) {
    const blink = () => {
      const tl = gsap.timeline();

      tl.to([eyeRightFill, eyeRightLine, eyeLeftFill, eyeLeftLine], {
        scaleY: 0.1,
        duration: 0.08,
        transformOrigin: "center",
      }).to([eyeRightFill, eyeRightLine, eyeLeftFill, eyeLeftLine], {
        scaleY: 1,
        duration: 0.12,
      });

      if (Math.random() < 0.2) {
        tl.to({}, { duration: 0.12 })
          .to([eyeRightFill, eyeRightLine, eyeLeftFill, eyeLeftLine], {
            scaleY: 0.1,
            duration: 0.07,
          })
          .to([eyeRightFill, eyeRightLine, eyeLeftFill, eyeLeftLine], {
            scaleY: 1,
            duration: 0.1,
          });
      }
    };

    function scheduleBlink() {
      gsap.delayedCall(gsap.utils.random(2, 6), () => {
        blink();
        scheduleBlink();
      });
    }

    scheduleBlink();
  }
  if (area && svg && eyeRight && eyeLeft) {
    const maxX = 10;
    const maxY = 4;

    const rightX = gsap.quickTo(eyeRight, "x", {
      duration: 0.35,
      ease: "power3.out",
    });

    const rightY = gsap.quickTo(eyeRight, "y", {
      duration: 0.35,
      ease: "power3.out",
    });

    const leftX = gsap.quickTo(eyeLeft, "x", {
      duration: 0.35,
      ease: "power3.out",
    });

    const leftY = gsap.quickTo(eyeLeft, "y", {
      duration: 0.35,
      ease: "power3.out",
    });

    area.addEventListener("pointermove", (event) => {
      const bounds = svg.getBoundingClientRect();

      // mouse position relative to the SVG
      const mouseX = event.clientX - bounds.left;
      const mouseY = event.clientY - bounds.top;

      // center of the SVG
      const centerX = bounds.width / 2;
      const centerY = bounds.height / 2;

      // direction from center to cursor
      const deltaX = mouseX - centerX;
      const deltaY = mouseY - centerY;

      // normalize to roughly -1 ... 1
      const normalizedX = deltaX / centerX;
      const normalizedY = deltaY / centerY;

      // limit eye movement
      const x = gsap.utils.clamp(-maxX, maxX, normalizedX * maxX);

      const y = gsap.utils.clamp(-maxY, maxY, normalizedY * maxY);

      rightX(x);
      rightY(y);

      leftX(x);
      leftY(y);
    });
  }
</script>
