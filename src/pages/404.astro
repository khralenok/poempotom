---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../lib/urls';
---
<BaseLayout title="404" dark pageType="error">
  <main class="container error-layout">
    <div class="illustration"><img src={sitePath('/img/404.svg')} alt="" /></div>
    <div class="error-message">
        <p>This page doesn't exist, but there are others — <a href={sitePath('/')}>take a look</a></p>
    </div>
  </main>
</BaseLayout>
